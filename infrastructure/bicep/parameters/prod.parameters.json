{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "value": "prod"
    },
    "location": {
      "value": "australiaeast"
    },
    "geoRedundantLocation": {
      "value": "australiasoutheast"
    },
    "locationCode": {
      "value": "aue"
    },
    "applicationName": {
      "value": "numbatwallet"
    },
    "administratorObjectId": {
      "value": "" // To be filled with actual Azure AD admin object ID
    },
    "managedIdentityObjectId": {
      "value": "" // To be filled after managed identity creation
    },

    // Network Configuration
    "vnetAddressSpace": {
      "value": "10.0.0.0/16"
    },
    "subnets": {
      "value": [
        {
          "name": "snet-webapp",
          "addressPrefix": "10.0.1.0/24"
        },
        {
          "name": "snet-api",
          "addressPrefix": "10.0.2.0/24"
        },
        {
          "name": "snet-database",
          "addressPrefix": "10.0.3.0/24"
        },
        {
          "name": "snet-privateendpoints",
          "addressPrefix": "10.0.4.0/24"
        },
        {
          "name": "snet-management",
          "addressPrefix": "10.0.5.0/24"
        },
        {
          "name": "snet-apim",
          "addressPrefix": "10.0.6.0/24"
        }
      ]
    },
    "existingVnetResourceGroup": {
      "value": "" // To be filled with existing VNet RG if applicable
    },
    "existingVnetName": {
      "value": "" // To be filled with existing VNet name if applicable
    },
    "privateEndpointSubnetId": {
      "value": "" // To be filled with subnet ID for private endpoints
    },

    // SKU Configuration - Production with High Availability
    "appServicePlanSku": {
      "value": {
        "name": "P3V3",
        "tier": "PremiumV3",
        "capacity": 3
      }
    },
    "sqlServerSku": {
      "value": {
        "name": "P4",
        "tier": "Premium",
        "capacity": 250
      }
    },
    "redisCacheSku": {
      "value": {
        "name": "P1",
        "family": "P",
        "capacity": 1
      }
    },
    "containerAppEnvironmentSku": {
      "value": {
        "name": "WorkloadProfiles",
        "tier": "WorkloadProfiles"
      }
    },

    // PostgreSQL Configuration
    "postgresAdminUsername": {
      "value": "nwadmin"
    },
    "postgresAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/{subscriptionId}/resourceGroups/rg-numbatwallet-prod-aue/providers/Microsoft.KeyVault/vaults/kv-numbatwallet-prod-aue"
        },
        "secretName": "PostgresAdminPassword"
      }
    },
    "postgresDatabaseName": {
      "value": "numbatwallet-prod"
    },
    "postgresBackupRetentionDays": {
      "value": 35
    },
    "postgresGeoRedundantBackup": {
      "value": true
    },
    "postgresEnableHa": {
      "value": true
    },
    "postgresEnableTde": {
      "value": true
    },
    "postgresEnableAuditLogging": {
      "value": true
    },

    // Security Configuration
    "enablePrivateEndpoints": {
      "value": true
    },
    "requireMfa": {
      "value": true
    },
    "sessionTimeoutMinutes": {
      "value": 30
    },
    "enableWaf": {
      "value": true
    },
    "enableDdosProtection": {
      "value": true
    },
    "tlsVersion": {
      "value": "1.3"
    },
    "allowedIpAddresses": {
      "value": []
    },

    // Application Settings
    "applicationSettings": {
      "value": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "Logging__LogLevel__Default": "Warning",
        "Logging__LogLevel__Microsoft": "Error",
        "Logging__LogLevel__System": "Error",
        "DetailedErrors": "false",
        "EnableSensitiveDataLogging": "false",
        "GraphQL__EnableIntrospection": "false",
        "GraphQL__EnablePlayground": "false",
        "RateLimiting__Enabled": "true",
        "RateLimiting__PermitLimit": "30",
        "RateLimiting__Window": "60",
        "Cache__SlidingExpiration": "1800",
        "Cache__AbsoluteExpiration": "3600",
        "HealthCheck__Enabled": "true",
        "Monitoring__EnableAPM": "true",
        "Monitoring__EnableMetrics": "true",
        "Monitoring__SamplingRate": "1.0",
        "Security__EnableSecurityHeaders": "true",
        "Security__EnableHsts": "true",
        "Security__HstsMaxAge": "31536000",
        "Security__EnableCsp": "true"
      }
    },

    // High Availability Configuration
    "enableZoneRedundancy": {
      "value": true
    },
    "replicaCount": {
      "value": 3
    },
    "enableAutoScaling": {
      "value": true
    },
    "minInstances": {
      "value": 3
    },
    "maxInstances": {
      "value": 10
    },

    // Disaster Recovery Configuration
    "enableBackupVault": {
      "value": true
    },
    "backupSchedule": {
      "value": "0 2 * * *"  // Daily at 2 AM
    },
    "disasterRecoveryTier": {
      "value": "Hot"
    },
    "rpoMinutes": {
      "value": 15
    },
    "rtoMinutes": {
      "value": 60
    },

    // Feature Flags
    "enableDebugLogging": {
      "value": false
    },
    "enableSwagger": {
      "value": false
    },
    "enableDeveloperExceptionPage": {
      "value": false
    },
    "enableDetailedErrors": {
      "value": false
    },
    "enableAutomatedBackups": {
      "value": true
    },
    "enableGeoReplication": {
      "value": true
    },

    // Tags
    "tags": {
      "value": {
        "Application": "NumbatWallet",
        "Environment": "Production",
        "ManagedBy": "Bicep",
        "CostCenter": "Digital-Services",
        "Owner": "WA-Government",
        "Compliance": "TDIF",
        "DataClassification": "Sensitive",
        "SLA": "99.5",
        "ISO27001": "Compliant",
        "GDPR": "Ready"
      }
    }
  }
}