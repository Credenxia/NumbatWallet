{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "value": "dev"
    },
    "location": {
      "value": "australiaeast"
    },
    "locationCode": {
      "value": "aue"
    },
    "applicationName": {
      "value": "numbatwallet"
    },
    "administratorObjectId": {
      "value": "" // To be filled with actual Azure AD admin object ID
    },
    "managedIdentityObjectId": {
      "value": "" // To be filled after managed identity creation
    },

    // Network Configuration
    "vnetAddressSpace": {
      "value": "10.3.0.0/16"
    },
    "subnets": {
      "value": [
        {
          "name": "snet-default",
          "addressPrefix": "10.3.1.0/24"
        }
      ]
    },

    // SKU Configuration - Cost-optimized for development
    "appServicePlanSku": {
      "value": {
        "name": "B3",
        "tier": "Basic",
        "capacity": 1
      }
    },
    "sqlServerSku": {
      "value": {
        "name": "Basic",
        "tier": "Basic",
        "capacity": 5
      }
    },
    "redisCacheSku": {
      "value": {
        "name": "C0",
        "family": "C",
        "capacity": 0
      }
    },
    "containerAppEnvironmentSku": {
      "value": {
        "name": "Consumption",
        "tier": "Consumption"
      }
    },

    // PostgreSQL Configuration
    "postgresAdminUsername": {
      "value": "nwadmin"
    },
    "postgresAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "" // To be filled with Key Vault resource ID
        },
        "secretName": "PostgresAdminPassword"
      }
    },
    "postgresDatabaseName": {
      "value": "numbatwallet-dev"
    },
    "postgresBackupRetentionDays": {
      "value": 7
    },
    "postgresGeoRedundantBackup": {
      "value": false
    },

    // Security Configuration
    "enablePrivateEndpoints": {
      "value": false
    },
    "requireMfa": {
      "value": false
    },
    "sessionTimeoutMinutes": {
      "value": 480
    },
    "enableWaf": {
      "value": false
    },
    "tlsVersion": {
      "value": "1.2"
    },
    "allowedIpAddresses": {
      "value": [
        // Add developer IP addresses here for dev environment
      ]
    },

    // Application Settings
    "applicationSettings": {
      "value": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Logging__LogLevel__Default": "Debug",
        "Logging__LogLevel__Microsoft": "Information",
        "Logging__LogLevel__System": "Information",
        "DetailedErrors": "true",
        "EnableSensitiveDataLogging": "true",
        "GraphQL__EnableIntrospection": "true",
        "GraphQL__EnablePlayground": "true",
        "RateLimiting__Enabled": "false",
        "Cache__SlidingExpiration": "60",
        "HealthCheck__Enabled": "true",
        "HealthCheck__Path": "/health"
      }
    },

    // Connection Strings (loaded from Key Vault in higher envs)
    "connectionStrings": {
      "value": {
        "DefaultConnection": "@Microsoft.KeyVault(VaultName=kv-nw-dev-aue;SecretName=ConnectionString)",
        "RedisConnection": "@Microsoft.KeyVault(VaultName=kv-nw-dev-aue;SecretName=RedisConnection)",
        "StorageConnection": "@Microsoft.KeyVault(VaultName=kv-nw-dev-aue;SecretName=StorageConnection)"
      }
    },

    // Feature Flags
    "enableDebugLogging": {
      "value": true
    },
    "enableSwagger": {
      "value": true
    },
    "enableDeveloperExceptionPage": {
      "value": true
    },
    "enableDetailedErrors": {
      "value": true
    },
    "enableSqlDebugger": {
      "value": true
    },
    "enableAutomatedBackups": {
      "value": false
    },

    // Tags
    "tags": {
      "value": {
        "Application": "NumbatWallet",
        "Environment": "Development",
        "ManagedBy": "Bicep",
        "CostCenter": "Development",
        "Owner": "Development-Team",
        "Purpose": "Development and Testing",
        "AutoShutdown": "true",
        "ShutdownTime": "18:00"
      }
    }
  }
}