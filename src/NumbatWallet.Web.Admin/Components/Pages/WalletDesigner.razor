@page "/wallet-designer"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Wallet Designer - NumbatWallet Admin</PageTitle>

<div class="page-header">
    <h1>Wallet Designer</h1>
    <div class="page-actions">
        <button class="btn btn-secondary">
            <i class="bi bi-folder-open"></i> Load Template
        </button>
        <button class="btn btn-primary">
            <i class="bi bi-plus-square"></i> New Design
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        <div class="card">
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="bi bi-palette"></i>
                    <div>
                        <strong>Wallet Designer</strong>
                        <p class="mb-0">Visual wallet pass designer for Apple Wallet and Google Wallet will be available soon.</p>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-shield-exclamation"></i>
            <div>
                <strong>Authentication Required</strong>
                <p class="mb-0">Please <a href="/login">sign in</a> to access the wallet designer.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
