</style>

@code {
    private bool IsLoading = false;
    private string? ErrorMessage;
    private List<CredentialDto> AllCredentials = new();
    private List<CredentialDto> FilteredCredentials = new();

    private string SearchTerm = "";
    private string TypeFilter = "";
    private string StatusFilter = "";
    private string IssuerFilter = "";

    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalCount = 0;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    private int TotalCredentials => AllCredentials.Count;
    private int ActiveCredentials => AllCredentials.Count(c => c.Status == "Active");
    private int ExpiringCredentials => AllCredentials.Count(c =>
        c.Status == "Active" && c.ExpiryDate.HasValue &&
        (c.ExpiryDate.Value - DateTime.Now).Days < 30);
    private int RevokedCredentials => AllCredentials.Count(c => c.Status == "Revoked");

    private bool ShowIssueModal = false;
    private CredentialDto NewCredential = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCredentials();
    }

    private async Task LoadCredentials()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            // Simulate API call
            await Task.Delay(500);

            AllCredentials = GenerateSampleCredentials();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load credentials");
            ErrorMessage = "Failed to load credentials.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var filtered = AllCredentials.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            filtered = filtered.Where(c =>
                c.Id.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.HolderName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Type.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(TypeFilter))
        {
            filtered = filtered.Where(c => c.Type == TypeFilter);
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            filtered = filtered.Where(c => c.Status == StatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(IssuerFilter))
        {
            filtered = filtered.Where(c => c.IssuerId == IssuerFilter);
        }

        TotalCount = filtered.Count();
        FilteredCredentials = filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? "";
        CurrentPage = 1;
        ApplyFilters();
    }

    private async Task OnFilterChanged()
    {
        CurrentPage = 1;
        ApplyFilters();
        await Task.CompletedTask;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            ApplyFilters();
        }
    }

    private void OpenIssueModal()
    {
        NewCredential = new CredentialDto
        {
            ValidFrom = DateTime.Now,
            ValidUntil = DateTime.Now.AddYears(1)
        };
        ShowIssueModal = true;
    }

    private void CloseIssueModal()
    {
        ShowIssueModal = false;
        NewCredential = new();
    }

    private async Task IssueCredential()
    {
        try
        {
            // Issue credential via API
            await Task.Delay(500);
            CloseIssueModal();
            await LoadCredentials();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to issue credential");
        }
    }

    private async Task ExportCredentials()
    {
        await JS.InvokeVoidAsync("console.log", "Exporting credentials...");
    }

    private void ViewCredential(CredentialDto credential)
    {
        // Navigate to credential details
    }

    private async Task VerifyCredential(CredentialDto credential)
    {
        await JS.InvokeVoidAsync("console.log", "Verifying credential:", credential.Id);
    }

    private async Task SuspendCredential(CredentialDto credential)
    {
        credential.Status = "Suspended";
        ApplyFilters();
    }

    private async Task RevokeCredential(CredentialDto credential)
    {
        credential.Status = "Revoked";
        ApplyFilters();
    }

    private async Task ReactivateCredential(CredentialDto credential)
    {
        credential.Status = "Active";
        ApplyFilters();
    }

    private async Task CopyId(string id)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", id);
    }

    private string GetCredentialIcon(string type)
    {
        return type switch
        {
            "DriverLicense" => "bi bi-car-front",
            "WorkingWithChildren" => "bi bi-people",
            "ProofOfAge" => "bi bi-person-badge",
            "StudentID" => "bi bi-mortarboard",
            "HealthCard" => "bi bi-heart-pulse",
            "Professional" => "bi bi-briefcase",
            _ => "bi bi-card-text"
        };
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Active" => "badge-success",
            "Suspended" => "badge-warning",
            "Revoked" => "badge-danger",
            "Expired" => "badge-secondary",
            _ => "badge-secondary"
        };
    }

    private List<CredentialDto> GenerateSampleCredentials()
    {
        var credentials = new List<CredentialDto>();
        var random = new Random();

        var types = new[] { "DriverLicense", "WorkingWithChildren", "ProofOfAge", "StudentID", "HealthCard", "Professional" };
        var names = new[] { "John Smith", "Sarah Johnson", "Michael Brown", "Emma Wilson", "James Davis", "Lisa Anderson" };
        var issuers = new[] {
            ("wa-transport", "WA Transport"),
            ("wa-health", "WA Health"),
            ("wa-police", "WA Police"),
            ("curtin-uni", "Curtin University")
        };
        var statuses = new[] { "Active", "Active", "Active", "Suspended", "Revoked", "Expired" };

        for (int i = 0; i < 50; i++)
        {
            var type = types[random.Next(types.Length)];
            var name = names[random.Next(names.Length)];
            var issuer = issuers[random.Next(issuers.Length)];
            var status = statuses[random.Next(statuses.Length)];
            var issuedDate = DateTime.Now.AddDays(-random.Next(1, 365));
            var expiryDate = type == "StudentID" ?
                (DateTime?)issuedDate.AddYears(1) :
                issuedDate.AddYears(random.Next(1, 5));

            credentials.Add(new CredentialDto
            {
                Id = $"VC-{Guid.NewGuid().ToString("N").Substring(0, 8).ToUpper()}",
                Type = type,
                HolderName = name,
                HolderEmail = $"{name.Replace(" ", ".").ToLower()}@example.com",
                IssuerId = issuer.Item1,
                IssuerName = issuer.Item2,
                Status = status,
                IssuedDate = issuedDate,
                ExpiryDate = expiryDate,
                WalletDid = $"did:ion:EiD{Guid.NewGuid().ToString("N").Substring(0, 20)}"
            });
        }

        return credentials.OrderByDescending(c => c.IssuedDate).ToList();
    }

    private class CredentialDto
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public string HolderName { get; set; } = "";
        public string HolderEmail { get; set; } = "";
        public string IssuerId { get; set; } = "";
        public string IssuerName { get; set; } = "";
        public string Status { get; set; } = "Active";
        public DateTime IssuedDate { get; set; } = DateTime.Now;
        public DateTime? ExpiryDate { get; set; }
        public string WalletDid { get; set; } = "";
        public DateTime ValidFrom { get; set; } = DateTime.Now;
        public DateTime? ValidUntil { get; set; }
    }
}