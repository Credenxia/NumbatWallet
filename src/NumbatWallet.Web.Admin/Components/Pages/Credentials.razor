@page "/credentials"
@using Microsoft.AspNetCore.Components.Authorization
@using NumbatWallet.Web.Admin.Components.Common
@using NumbatWallet.Web.Admin.Services
@inject IApiClient ApiClient
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject ILogger<Credentials> Logger

<PageTitle>Credentials - NumbatWallet Admin</PageTitle>

<div class="page-header">
    <h1>Credential Management</h1>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="ExportCredentials">
            <i class="bi bi-download"></i> Export
        </button>
        <button class="btn btn-primary" @onclick="OpenIssueModal">
            <i class="bi bi-award"></i> Issue Credential
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        @if (IsLoading)
        {
            <div class="loading-container">
                <LoadingSpinner IsLoading="true" LoadingText="Loading credentials..." />
            </div>
        }
        else if (ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Error:</strong> @ErrorMessage
            </div>
        }
        else
        {
            <!-- Stats Cards -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@TotalCredentials.ToString("N0")</div>
                        <div class="stat-label">Total Credentials</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@ActiveCredentials.ToString("N0")</div>
                        <div class="stat-label">Active</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@ExpiringCredentials.ToString("N0")</div>
                        <div class="stat-label">Expiring Soon</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@RevokedCredentials.ToString("N0")</div>
                        <div class="stat-label">Revoked</div>
                    </div>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" @bind="SearchTerm" @oninput="@(async (e) => await OnSearchChanged(e))"
                           placeholder="Search by ID, holder, or type..." class="form-control" />
                </div>
                <div class="filter-group">
                    <select @bind="TypeFilter" @bind:event="onchange" @bind:after="OnFilterChanged" class="form-control">
                        <option value="">All Types</option>
                        <option value="DriverLicense">Driver License</option>
                        <option value="WorkingWithChildren">Working With Children</option>
                        <option value="ProofOfAge">Proof of Age</option>
                        <option value="StudentID">Student ID</option>
                        <option value="HealthCard">Health Card</option>
                        <option value="Professional">Professional License</option>
                    </select>
                    <select @bind="StatusFilter" @bind:event="onchange" @bind:after="OnFilterChanged" class="form-control">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Revoked">Revoked</option>
                        <option value="Expired">Expired</option>
                    </select>
                    <select @bind="IssuerFilter" @bind:event="onchange" @bind:after="OnFilterChanged" class="form-control">
                        <option value="">All Issuers</option>
                        <option value="wa-transport">WA Transport</option>
                        <option value="wa-health">WA Health</option>
                        <option value="wa-police">WA Police</option>
                        <option value="curtin-uni">Curtin University</option>
                    </select>
                </div>
            </div>

            <!-- Credentials Table -->
            <div class="credentials-table">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Credential ID</th>
                            <th>Type</th>
                            <th>Holder</th>
                            <th>Issuer</th>
                            <th>Status</th>
                            <th>Issued Date</th>
                            <th>Expiry Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var credential in FilteredCredentials)
                        {
                            <tr>
                                <td>
                                    <div class="credential-id">
                                        <code>@credential.Id</code>
                                        <button class="btn-icon" @onclick="() => CopyId(credential.Id)">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="credential-type">
                                        <i class="@GetCredentialIcon(credential.Type)"></i>
                                        @credential.Type
                                    </div>
                                </td>
                                <td>
                                    <div class="holder-info">
                                        <strong>@credential.HolderName</strong>
                                        <small class="text-muted d-block">@credential.HolderEmail</small>
                                    </div>
                                </td>
                                <td>@credential.IssuerName</td>
                                <td>
                                    <span class="badge @GetStatusClass(credential.Status)">
                                        @credential.Status
                                    </span>
                                </td>
                                <td>@credential.IssuedDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (credential.ExpiryDate.HasValue)
                                    {
                                        var daysUntilExpiry = (credential.ExpiryDate.Value - DateTime.Now).Days;
                                        <span class="@(daysUntilExpiry < 30 ? "text-warning" : "")">
                                            @credential.ExpiryDate.Value.ToString("MMM d, yyyy")
                                            @if (daysUntilExpiry < 30)
                                            {
                                                <small class="text-warning">(@daysUntilExpiry days)</small>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-icon" title="View Details" @onclick="() => ViewCredential(credential)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn-icon" title="Verify" @onclick="() => VerifyCredential(credential)">
                                            <i class="bi bi-shield-check"></i>
                                        </button>
                                        @if (credential.Status == "Active")
                                        {
                                            <button class="btn-icon text-warning" title="Suspend" @onclick="() => SuspendCredential(credential)">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                            <button class="btn-icon text-danger" title="Revoke" @onclick="() => RevokeCredential(credential)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else if (credential.Status == "Suspended")
                                        {
                                            <button class="btn-icon text-success" title="Reactivate" @onclick="() => ReactivateCredential(credential)">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, TotalCount) of @TotalCount credentials
                </div>
                <nav aria-label="Credentials pagination">
                    <ul class="pagination">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">
                                Previous
                            </button>
                        </li>
                        @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h4 class="alert-heading">Authentication Required</h4>
            <p>You must be logged in to manage credentials.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<!-- Issue Credential Modal -->
@if (ShowIssueModal)
{
    <div class="modal-backdrop" @onclick="CloseIssueModal"></div>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Issue New Credential</h5>
                <button type="button" class="btn-close" @onclick="CloseIssueModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="NewCredential" OnValidSubmit="IssueCredential">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Credential Type</label>
                                <InputSelect @bind-Value="NewCredential.Type" class="form-control">
                                    <option value="">Select Type</option>
                                    <option value="DriverLicense">Driver License</option>
                                    <option value="WorkingWithChildren">Working With Children Check</option>
                                    <option value="ProofOfAge">Proof of Age Card</option>
                                    <option value="StudentID">Student ID</option>
                                    <option value="HealthCard">Health Card</option>
                                    <option value="Professional">Professional License</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Wallet DID</label>
                                <InputText @bind-Value="NewCredential.WalletDid" class="form-control" placeholder="did:ion:..." />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Holder Name</label>
                                <InputText @bind-Value="NewCredential.HolderName" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Holder Email</label>
                                <InputText @bind-Value="NewCredential.HolderEmail" class="form-control" type="email" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Valid From</label>
                                <InputDate @bind-Value="NewCredential.ValidFrom" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Valid Until</label>
                                <InputDate @bind-Value="NewCredential.ValidUntil" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Credential Attributes</label>
                        <div class="attributes-editor">
                            <div class="attribute-row">
                                <input type="text" placeholder="Attribute name" class="form-control" />
                                <input type="text" placeholder="Value" class="form-control" />
                                <button type="button" class="btn btn-sm btn-secondary">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseIssueModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Issue Credential</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .credentials-table {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .credentials-table .table {
        margin-bottom: 0;
    }

    .credentials-table thead {
        background: var(--bg-secondary);
    }

    .credentials-table th {
        padding: 1rem;
        font-weight: 600;
        color: var(--text-secondary);
        border-bottom: 2px solid var(--border);
    }

    .credentials-table td {
        padding: 0.875rem 1rem;
        vertical-align: middle;
    }

    .credentials-table tbody tr:hover {
        background: var(--bg-hover);
    }

    .credential-id {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .credential-id code {
        font-size: 0.875rem;
        color: var(--text-secondary);
        background: var(--bg-primary);
        padding: 0.125rem 0.25rem;
        border-radius: 4px;
    }

    .credential-type {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
    }

    .holder-info {
        display: flex;
        flex-direction: column;
    }

    .badge {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .badge-success {
        background: rgba(34, 197, 94, 0.1);
        color: var(--success);
    }

    .badge-warning {
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
    }

    .badge-danger {
