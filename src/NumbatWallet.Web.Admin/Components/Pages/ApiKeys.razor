@page "/api-keys"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<PageTitle>API Keys - NumbatWallet Admin</PageTitle>

<div class="page-header">
    <h1>API Key Management</h1>
    <div class="page-actions">
        <button class="btn btn-primary">
            <i class="bi bi-key-fill"></i> Generate API Key
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        <div class="card">
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="bi bi-key"></i>
                    <div>
                        <strong>API Key Management</strong>
                        <p class="mb-0">Create and manage API keys for programmatic access to NumbatWallet services.</p>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-shield-exclamation"></i>
            <div>
                <strong>Authentication Required</strong>
                <p class="mb-0">Please <a href="/login">sign in</a> to manage API keys.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
