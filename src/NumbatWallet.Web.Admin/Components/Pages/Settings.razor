@page "/settings"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<PageTitle>Settings - NumbatWallet Admin</PageTitle>

<div class="page-header">
    <h1>System Settings</h1>
    <div class="page-actions">
        <button class="btn btn-primary">
            <i class="bi bi-save"></i> Save Changes
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="card-title">General Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="bi bi-gear"></i>
                            <div>
                                <strong>Configuration</strong>
                                <p class="mb-0">Platform settings and configuration options.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="card-title">Security Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="bi bi-shield-lock"></i>
                            <div>
                                <strong>Security</strong>
                                <p class="mb-0">Security policies and authentication settings.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-shield-exclamation"></i>
            <div>
                <strong>Authentication Required</strong>
                <p class="mb-0">Please <a href="/login">sign in</a> to access settings.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
