@page "/"
@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using NumbatWallet.Web.Admin.Components.Common
@using NumbatWallet.Web.Admin.Services
@attribute [Authorize]
@inject IAdminGraphQLClient GraphQLClient
@inject IAuthService AuthService
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - NumbatWallet Admin</PageTitle>

<div class="dashboard-header">
    <h1>Dashboard</h1>
    <div class="dashboard-actions">
        <button class="btn btn-secondary">
            <i class="bi bi-download"></i> Export Report
        </button>
        <button class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Wallet
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        @if (IsLoading)
        {
            <div class="loading-container">
                <LoadingSpinner IsLoading="true" LoadingText="Loading dashboard statistics..." />
            </div>
        }
        else if (ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Error:</strong> @ErrorMessage
            </div>
        }
        else
        {
            <!-- Metric Cards Row -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-label">Total Users</div>
                        <div class="metric-value">@(Data?.DatabaseStats?.TotalPersons ?? 0)</div>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-label">Active Wallets</div>
                        <div class="metric-value">@(Data?.DashboardStatistics?.ActiveWallets ?? 0)</div>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-label">Total Credentials</div>
                        <div class="metric-value">@(Data?.DashboardStatistics?.TotalCredentials ?? 0)</div>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-label">Active Credentials</div>
                        <div class="metric-value">@(Data?.CredentialStatistics?.ActiveCredentials ?? 0)</div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Recent Activity</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Credentials Issued Today</span>
                                    <strong>@(Data?.DashboardStatistics?.CredentialsIssuedToday ?? 0)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Expiring This Week</span>
                                    <strong class="text-warning">@(Data?.DashboardStatistics?.CredentialsExpiringThisWeek ?? 0)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Revoked Credentials</span>
                                    <strong>@(Data?.CredentialStatistics?.RevokedCredentials ?? 0)</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Database Size</span>
                                    <strong>@($"{Data?.DatabaseStats?.DatabaseSizeMB ?? 0:N1} MB")</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">System Health</h5>
                        </div>
                        <div class="card-body">
                            @{
                                var healthStatus = Data?.SystemHealth?.Status ?? "Unknown";
                                var isHealthy = string.Equals(healthStatus, "Healthy", StringComparison.OrdinalIgnoreCase);
                            }
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge @(isHealthy ? "bg-success" : "bg-warning") me-2">@healthStatus</span>
                                <span>@(isHealthy ? "All systems operational" : "Some components are degraded")</span>
                            </div>
                            <div class="progress mb-2">
                                <div class="progress-bar @(isHealthy ? "bg-success" : "bg-warning")" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted">Last checked: @(Data?.SystemHealth?.CheckedAt.ToLocalTime().ToString("g") ?? "—")</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Authentication Required</h4>
            <p>You must be logged in to view the dashboard.</p>
            <hr>
            <p class="mb-0">Please <a href="/login" class="alert-link">sign in</a> to continue.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private AdminDashboardData? Data { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDashboardData();
            StateHasChanged();
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));

            // Live data from the admin GraphQL API (dashboardStatistics, credentialStatistics,
            // systemHealth, databaseStats) — no mock fallback: failures are shown honestly.
            Data = await GraphQLClient.GetDashboardDataAsync(cts.Token);

            if (Data is null)
            {
                ErrorMessage = "Failed to load dashboard statistics from the API.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading dashboard");
            ErrorMessage = "Failed to load dashboard statistics from the API.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
