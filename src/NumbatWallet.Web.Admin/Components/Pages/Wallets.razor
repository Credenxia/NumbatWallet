@page "/wallets"
@using Microsoft.AspNetCore.Components.Authorization
@using NumbatWallet.Web.Admin.Components.Common
@using NumbatWallet.Web.Admin.Services
@attribute [Authorize]
@inject IApiClient ApiClient
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject ILogger<Wallets> Logger

<PageTitle>Wallets - NumbatWallet Admin</PageTitle>

<div class="page-header">
    <h1>Wallet Management</h1>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="RefreshWallets">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-wallet2"></i> Create Wallet
        </button>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        @if (IsLoading)
        {
            <div class="loading-container">
                <LoadingSpinner IsLoading="true" LoadingText="Loading wallets..." />
            </div>
        }
        else if (ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Error:</strong> @ErrorMessage
            </div>
        }
        else
        {
            <!-- Stats Cards -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@TotalWallets.ToString("N0")</div>
                        <div class="stat-label">Total Wallets</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@ActiveWallets.ToString("N0")</div>
                        <div class="stat-label">Active</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="bi bi-pause-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@SuspendedWallets.ToString("N0")</div>
                        <div class="stat-label">Suspended</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@TotalCredentials.ToString("N0")</div>
                        <div class="stat-label">Credentials</div>
                    </div>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" @bind="SearchTerm" @oninput="@(async (e) => await OnSearchChanged(e))"
                           placeholder="Search by DID or holder name..." class="form-control" />
                </div>
                <div class="filter-group">
                    <select @bind="StatusFilter" @bind:event="onchange" @bind:after="OnFilterChanged" class="form-control">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Revoked">Revoked</option>
                    </select>
                    <select @bind="TenantFilter" @bind:event="onchange" @bind:after="OnFilterChanged" class="form-control">
                        <option value="">All Tenants</option>
                        <option value="wa-health">WA Health</option>
                        <option value="wa-transport">WA Transport</option>
                        <option value="curtin-uni">Curtin University</option>
                    </select>
                </div>
            </div>

            <!-- Wallets Grid -->
            <div class="wallets-grid">
                @foreach (var wallet in FilteredWallets)
                {
                    <div class="wallet-card">
                        <div class="wallet-header">
                            <div class="wallet-status @($"status-{wallet.Status.ToLower()}")">
                                @wallet.Status
                            </div>
                            <div class="wallet-actions">
                                <button class="btn-icon" title="View Details" @onclick="() => ViewWallet(wallet)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn-icon" title="Edit" @onclick="() => EditWallet(wallet)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn-icon" title="QR Code" @onclick="() => ShowQRCode(wallet)">
                                    <i class="bi bi-qr-code"></i>
                                </button>
                            </div>
                        </div>
                        <div class="wallet-body">
                            <div class="wallet-did">
                                <i class="bi bi-fingerprint"></i>
                                <span>@wallet.Did</span>
                            </div>
                            <div class="wallet-holder">
                                <strong>@wallet.HolderName</strong>
                                <small class="text-muted">@wallet.HolderEmail</small>
                            </div>
                            <div class="wallet-info">
                                <div class="info-item">
                                    <i class="bi bi-building"></i>
                                    <span>@wallet.TenantName</span>
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-card-checklist"></i>
                                    <span>@wallet.CredentialCount credentials</span>
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-calendar"></i>
                                    <span>Created @wallet.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>
                            </div>
                        </div>
                        <div class="wallet-footer">
                            <button class="btn btn-sm btn-secondary" @onclick="() => ViewCredentials(wallet)">
                                View Credentials
                            </button>
                            @if (wallet.Status == "Active")
                            {
                                <button class="btn btn-sm btn-warning" @onclick="() => SuspendWallet(wallet)">
                                    Suspend
                                </button>
                            }
                            else if (wallet.Status == "Suspended")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => ActivateWallet(wallet)">
                                    Activate
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, TotalCount) of @TotalCount wallets
                </div>
                <nav aria-label="Wallets pagination">
                    <ul class="pagination">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">
                                Previous
                            </button>
                        </li>
                        @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h4 class="alert-heading">Authentication Required</h4>
            <p>You must be logged in to manage wallets.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<!-- Create Wallet Modal -->
@if (ShowCreateModal)
{
    <div class="modal-backdrop" @onclick="CloseCreateModal"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Wallet</h5>
                <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="NewWallet" OnValidSubmit="CreateWallet">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label class="form-label">Holder Name</label>
                        <InputText @bind-Value="NewWallet.HolderName" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="NewWallet.HolderEmail" class="form-control" type="email" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tenant</label>
                        <InputSelect @bind-Value="NewWallet.TenantId" class="form-control">
                            <option value="">Select Tenant</option>
                            <option value="wa-health">WA Health</option>
                            <option value="wa-transport">WA Transport</option>
                            <option value="curtin-uni">Curtin University</option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Wallet Type</label>
                        <InputSelect @bind-Value="NewWallet.Type" class="form-control">
                            <option value="Personal">Personal</option>
                            <option value="Professional">Professional</option>
                            <option value="Government">Government</option>
                        </InputSelect>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Wallet</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
    }

    .stat-content {
        flex: 1;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--text-primary);
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .wallets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .wallet-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s;
    }

    .wallet-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    .wallet-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .wallet-status {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .wallet-status.status-active {
        background: rgba(34, 197, 94, 0.1);
        color: var(--success);
    }

    .wallet-status.status-suspended {
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
    }

    .wallet-status.status-revoked {
        background: rgba(239, 68, 68, 0.1);
        color: var(--error);
    }

    .wallet-actions {
        display: flex;
        gap: 0.25rem;
    }

    .wallet-body {
        padding: 1rem;
    }

    .wallet-did {
        font-family: monospace;
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .wallet-holder {
        margin-bottom: 1rem;
    }

    .wallet-holder strong {
        display: block;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .wallet-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .wallet-footer {
        padding: 1rem;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 0.5rem;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }
</style>

@code {
    private bool IsLoading = false;
    private string? ErrorMessage;
    private List<WalletDto> AllWallets = new();
    private List<WalletDto> FilteredWallets = new();

    private string SearchTerm = "";
    private string StatusFilter = "";
    private string TenantFilter = "";

    private int CurrentPage = 1;
    private int PageSize = 9;
    private int TotalCount = 0;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    private int TotalWallets => AllWallets.Count;
    private int ActiveWallets => AllWallets.Count(w => w.Status == "Active");
    private int SuspendedWallets => AllWallets.Count(w => w.Status == "Suspended");
    private int TotalCredentials => AllWallets.Sum(w => w.CredentialCount);

    private bool ShowCreateModal = false;
    private WalletDto NewWallet = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWallets();
    }

    private async Task LoadWallets()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            // Simulate API call
            await Task.Delay(500);

            AllWallets = GenerateSampleWallets();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load wallets");
            ErrorMessage = "Failed to load wallets.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var filtered = AllWallets.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            filtered = filtered.Where(w =>
                w.Did.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                w.HolderName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            filtered = filtered.Where(w => w.Status == StatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(TenantFilter))
        {
            filtered = filtered.Where(w => w.TenantId == TenantFilter);
        }

        TotalCount = filtered.Count();
        FilteredWallets = filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? "";
        CurrentPage = 1;
        ApplyFilters();
    }

    private async Task OnFilterChanged()
    {
        CurrentPage = 1;
        ApplyFilters();
        await Task.CompletedTask;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            ApplyFilters();
        }
    }

    private void OpenCreateModal()
    {
        NewWallet = new WalletDto();
        ShowCreateModal = true;
    }

    private void CloseCreateModal()
    {
        ShowCreateModal = false;
        NewWallet = new();
    }

    private async Task CreateWallet()
    {
        try
        {
            // Create wallet via API
            await Task.Delay(500);
            CloseCreateModal();
            await LoadWallets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create wallet");
        }
    }

    private async Task RefreshWallets()
    {
        await LoadWallets();
    }

    private void ViewWallet(WalletDto wallet)
    {
        // Navigate to wallet details
    }

    private void EditWallet(WalletDto wallet)
    {
        // Open edit modal
    }

    private void ShowQRCode(WalletDto wallet)
    {
        // Show QR code modal
    }

    private void ViewCredentials(WalletDto wallet)
    {
        // Navigate to credentials page filtered by wallet
    }

    private async Task SuspendWallet(WalletDto wallet)
    {
        wallet.Status = "Suspended";
        ApplyFilters();
    }

    private async Task ActivateWallet(WalletDto wallet)
    {
        wallet.Status = "Active";
        ApplyFilters();
    }

    private List<WalletDto> GenerateSampleWallets()
    {
        var wallets = new List<WalletDto>();
        var random = new Random();
        var names = new[] { "John Smith", "Sarah Johnson", "Michael Brown", "Emma Wilson", "James Davis", "Lisa Anderson" };
        var tenants = new[] { ("wa-health", "WA Health"), ("wa-transport", "WA Transport"), ("curtin-uni", "Curtin University") };
        var statuses = new[] { "Active", "Active", "Active", "Suspended" };

        for (int i = 0; i < 25; i++)
        {
            var name = names[random.Next(names.Length)];
            var tenant = tenants[random.Next(tenants.Length)];
            var status = statuses[random.Next(statuses.Length)];

            wallets.Add(new WalletDto
            {
                Did = $"did:ion:EiD{Guid.NewGuid().ToString("N").Substring(0, 20)}",
                HolderName = name,
                HolderEmail = $"{name.Replace(" ", ".").ToLower()}@example.com",
                TenantId = tenant.Item1,
                TenantName = tenant.Item2,
                Status = status,
                CredentialCount = random.Next(1, 10),
                CreatedAt = DateTime.Now.AddDays(-random.Next(1, 180)),
                Type = "Personal"
            });
        }

        return wallets.OrderByDescending(w => w.CreatedAt).ToList();
    }

    private class WalletDto
    {
        public string Did { get; set; } = "";
        public string HolderName { get; set; } = "";
        public string HolderEmail { get; set; } = "";
        public string TenantId { get; set; } = "";
        public string TenantName { get; set; } = "";
        public string Status { get; set; } = "Active";
        public int CredentialCount { get; set; }
        public DateTime CreatedAt { get; set; } = DateTime.Now;
        public string Type { get; set; } = "Personal";
    }
}