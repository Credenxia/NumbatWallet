@page "/users"
@page "/users/{UserId}"
@using Microsoft.JSInterop
@using NumbatWallet.Application.DTOs
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3>User Management</h3>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">User Management</h1>
            <p class="text-muted">Manage system users and their permissions</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateUserModal">
                <i class="bi bi-person-plus"></i> Add New User
            </button>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Search by name or email"
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="@(async () => await SearchUsers())" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterRole">
                        <option value="">All Roles</option>
                        <option value="Admin">Admin</option>
                        <option value="Officer">Officer</option>
                        <option value="User">User</option>
                        <option value="Auditor">Auditor</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filterStatus">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary w-100" @onclick="SearchUsers">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <span>Users (@filteredUsers.Count)</span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" @onclick="ExportUsers">
                        <i class="bi bi-download"></i> Export
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="RefreshUsers">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" class="form-check-input" @onchange="SelectAllUsers" />
                            </th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredUsers.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No users found
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in filteredUsers)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input"
                                               checked="@selectedUserIds.Contains(user.Id)"
                                               @onchange="@(() => ToggleUserSelection(user.Id))" />
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                                                @user.FirstName[0]@user.LastName[0]
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@user.FirstName @user.LastName</div>
                                                <small class="text-muted">@user.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-@GetRoleBadgeColor(user.Role)">@user.Role</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadgeColor(user.Status)">@user.Status</span>
                                    </td>
                                    <td>
                                        @if (user.LastLoginAt.HasValue)
                                        {
                                            <small>@user.LastLoginAt.Value.ToString("MM/dd/yyyy HH:mm")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Never</small>
                                        }
                                    </td>
                                    <td>
                                        <small>@user.CreatedAt.ToString("MM/dd/yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" @onclick="@(() => ViewUser(user))"
                                                    title="View details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="@(() => EditUser(user))"
                                                    title="Edit user">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-warning" @onclick="@(() => ResetPassword(user))"
                                                    title="Reset password">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="@(() => ToggleUserStatus(user))"
                                                    title="@(user.Status == "Active" ? "Suspend" : "Activate")">
                                                <i class="bi bi-@(user.Status == "Active" ? "lock" : "unlock")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (filteredUsers.Count > pageSize)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="@(() => ChangePage(currentPage - 1))">Previous</button>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="@(() => ChangePage(pageNum))">@pageNum</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="@(() => ChangePage(currentPage + 1))">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <!-- Bulk Actions -->
    @if (selectedUserIds.Any())
    {
        <div class="position-fixed bottom-0 start-50 translate-middle-x mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">@selectedUserIds.Count selected</span>
                        <button class="btn btn-sm btn-outline-success" @onclick="BulkActivate">
                            <i class="bi bi-check-circle"></i> Activate
                        </button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="BulkSuspend">
                            <i class="bi bi-pause-circle"></i> Suspend
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="BulkDelete">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">
                            <i class="bi bi-x"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create/Edit User Modal -->
@if (showUserModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit User" : "Create New User")</h5>
                    <button type="button" class="btn-close" @onclick="CloseUserModal"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" @bind="editingUser.FirstName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <input type="text" class="form-control" @bind="editingUser.LastName" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" @bind="editingUser.Email" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Role</label>
                                <select class="form-select" @bind="editingUser.Role">
                                    <option value="User">User</option>
                                    <option value="Officer">Officer</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Auditor">Auditor</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Department</label>
                                <input type="text" class="form-control" @bind="editingUser.Department" />
                            </div>
                            @if (!isEditMode)
                            {
                                <div class="col-md-12">
                                    <label class="form-label">Temporary Password</label>
                                    <input type="password" class="form-control" @bind="temporaryPassword" />
                                    <small class="text-muted">User will be required to change password on first login</small>
                                </div>
                            }
                            <div class="col-md-12">
                                <label class="form-label">Permissions</label>
                                <div class="row">
                                    @foreach (var permission in availablePermissions)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input"
                                                       id="@($"perm_{permission}")"
                                                       checked="@editingUser.Permissions.Contains(permission)"
                                                       @onchange="@(() => TogglePermission(permission))" />
                                                <label class="form-check-label" for="@($"perm_{permission}")">
                                                    @permission
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUserModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUser">
                        @(isEditMode ? "Update" : "Create") User
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserId { get; set; }

    private List<UserDto> users = new();
    private List<UserDto> filteredUsers = new();
    private HashSet<string> selectedUserIds = new();
    private string searchTerm = "";
    private string filterRole = "";
    private string filterStatus = "";
    private bool isLoading = false;

    private bool showUserModal = false;
    private bool isEditMode = false;
    private UserDto editingUser = new();
    private string temporaryPassword = "";

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private List<string> availablePermissions = new()
    {
        "ViewWallets", "CreateWallets", "EditWallets", "DeleteWallets",
        "ViewCredentials", "IssueCredentials", "RevokeCredentials",
        "ViewUsers", "ManageUsers", "ViewReports", "GenerateReports",
        "ViewAuditLogs", "SystemAdmin"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;

        // Simulate loading users
        await Task.Delay(500);

        users = GenerateMockUsers();
        ApplyFilters();

        isLoading = false;
        StateHasChanged();
    }

    private List<UserDto> GenerateMockUsers()
    {
        var random = new Random();
        var roles = new[] { "Admin", "Officer", "User", "Auditor" };
        var statuses = new[] { "Active", "Inactive", "Suspended" };
        var firstNames = new[] { "John", "Jane", "Mike", "Sarah", "David", "Emma", "Tom", "Lisa" };
        var lastNames = new[] { "Smith", "Johnson", "Williams", "Brown", "Jones", "Garcia", "Miller", "Davis" };

        var mockUsers = new List<UserDto>();

        for (int i = 1; i <= 25; i++)
        {
            var firstName = firstNames[random.Next(firstNames.Length)];
            var lastName = lastNames[random.Next(lastNames.Length)];

            mockUsers.Add(new UserDto
            {
                Id = Guid.NewGuid().ToString(),
                FirstName = firstName,
                LastName = lastName,
                Email = $"{firstName.ToLower()}.{lastName.ToLower()}{i}@agency.gov.au",
                Role = roles[random.Next(roles.Length)],
                Status = statuses[random.Next(statuses.Length)],
                Department = $"Department {random.Next(1, 6)}",
                CreatedAt = DateTime.UtcNow.AddDays(-random.Next(1, 365)),
                LastLoginAt = random.Next(100) > 20 ? DateTime.UtcNow.AddHours(-random.Next(1, 720)) : null,
                Permissions = availablePermissions.Take(random.Next(1, 6)).ToList()
            });
        }

        return mockUsers;
    }

    private void ApplyFilters()
    {
        filteredUsers = users.AsEnumerable().ToList();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            filteredUsers = filteredUsers.Where(u =>
                u.FirstName.ToLower().Contains(term) ||
                u.LastName.ToLower().Contains(term) ||
                u.Email.ToLower().Contains(term)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterRole))
        {
            filteredUsers = filteredUsers.Where(u => u.Role == filterRole).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            filteredUsers = filteredUsers.Where(u => u.Status == filterStatus).ToList();
        }

        totalPages = (int)Math.Ceiling(filteredUsers.Count / (double)pageSize);
        currentPage = 1;
    }

    private async Task SearchUsers()
    {
        ApplyFilters();
        await Task.CompletedTask;
    }

    private async Task RefreshUsers()
    {
        await LoadUsers();
    }

    private void ShowCreateUserModal()
    {
        isEditMode = false;
        editingUser = new UserDto
        {
            Id = Guid.NewGuid().ToString(),
            Status = "Active",
            Role = "User",
            Permissions = new List<string>()
        };
        temporaryPassword = GenerateTemporaryPassword();
        showUserModal = true;
    }

    private void EditUser(UserDto user)
    {
        isEditMode = true;
        editingUser = new UserDto
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            Role = user.Role,
            Status = user.Status,
            Department = user.Department,
            Permissions = new List<string>(user.Permissions)
        };
        showUserModal = true;
    }

    private void ViewUser(UserDto user)
    {
        Navigation.NavigateTo($"/users/{user.Id}");
    }

    private async Task SaveUser()
    {
        if (isEditMode)
        {
            var existingUser = users.FirstOrDefault(u => u.Id == editingUser.Id);
            if (existingUser != null)
            {
                existingUser.FirstName = editingUser.FirstName;
                existingUser.LastName = editingUser.LastName;
                existingUser.Email = editingUser.Email;
                existingUser.Role = editingUser.Role;
                existingUser.Department = editingUser.Department;
                existingUser.Permissions = editingUser.Permissions;
            }
        }
        else
        {
            editingUser.CreatedAt = DateTime.UtcNow;
            users.Add(editingUser);
        }

        ApplyFilters();
        CloseUserModal();
        await Task.CompletedTask;
    }

    private void CloseUserModal()
    {
        showUserModal = false;
        editingUser = new();
        temporaryPassword = "";
    }

    private async Task ResetPassword(UserDto user)
    {
        // Simulate password reset
        await Task.Delay(100);
        // Show notification
    }

    private async Task ToggleUserStatus(UserDto user)
    {
        user.Status = user.Status == "Active" ? "Suspended" : "Active";
        await Task.CompletedTask;
    }

    private void ToggleUserSelection(string userId)
    {
        if (selectedUserIds.Contains(userId))
            selectedUserIds.Remove(userId);
        else
            selectedUserIds.Add(userId);
    }

    private void SelectAllUsers()
    {
        if (selectedUserIds.Count == filteredUsers.Count)
            selectedUserIds.Clear();
        else
            selectedUserIds = new HashSet<string>(filteredUsers.Select(u => u.Id));
    }

    private void ClearSelection()
    {
        selectedUserIds.Clear();
    }

    private async Task BulkActivate()
    {
        foreach (var userId in selectedUserIds)
        {
            var user = users.FirstOrDefault(u => u.Id == userId);
            if (user != null)
                user.Status = "Active";
        }
        selectedUserIds.Clear();
        await Task.CompletedTask;
    }

    private async Task BulkSuspend()
    {
        foreach (var userId in selectedUserIds)
        {
            var user = users.FirstOrDefault(u => u.Id == userId);
            if (user != null)
                user.Status = "Suspended";
        }
        selectedUserIds.Clear();
        await Task.CompletedTask;
    }

    private async Task BulkDelete()
    {
        users.RemoveAll(u => selectedUserIds.Contains(u.Id));
        selectedUserIds.Clear();
        ApplyFilters();
        await Task.CompletedTask;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private async Task ExportUsers()
    {
        // Simulate export
        await Task.Delay(100);
    }

    private void TogglePermission(string permission)
    {
        if (editingUser.Permissions.Contains(permission))
            editingUser.Permissions.Remove(permission);
        else
            editingUser.Permissions.Add(permission);
    }

    private string GenerateTemporaryPassword()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, 12)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }

    private string GetRoleBadgeColor(string role) => role switch
    {
        "Admin" => "danger",
        "Officer" => "warning",
        "Auditor" => "info",
        _ => "secondary"
    };

    private string GetStatusBadgeColor(string status) => status switch
    {
        "Active" => "success",
        "Inactive" => "secondary",
        "Suspended" => "warning",
        _ => "secondary"
    };

    public class UserDto
    {
        public string Id { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Status { get; set; } = "";
        public string Department { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime? LastLoginAt { get; set; }
        public List<string> Permissions { get; set; } = new();
    }
}