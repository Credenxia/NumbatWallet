{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "NumbatWallet": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<POSTGRES_SERVER>;Database=numbatwallet;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require;Trust Server Certificate=false",
    "Redis": "<REDIS_HOST>:6380,password=<FROM_KEY_VAULT>,ssl=true,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Azure": {
    "KeyVault": {
      "Url": "https://<KEY_VAULT_NAME>.vault.azure.net/"
    },
    "Storage": {
      "AccountName": "<STORAGE_ACCOUNT_NAME>",
      "_Comment": "Using managed identity - no connection string needed"
    },
    "ApplicationInsights": {
      "ConnectionString": "InstrumentationKey=<APP_INSIGHTS_KEY>;IngestionEndpoint=https://australiaeast-1.in.applicationinsights.azure.com/;LiveEndpoint=https://australiaeast.livediagnostics.monitor.azure.com/"
    }
  },
  "UseAzureKeyVault": true,
  "UseBlobStorage": true,
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<AZURE_AD_TENANT_ID>",
    "ClientId": "<AZURE_AD_CLIENT_ID>",
    "ClientSecret": "<FROM_KEY_VAULT>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc"
  },
  "ServiceWA": {
    "Authority": "https://identity.wa.gov.au",
    "Audience": "numbatwallet-api",
    "Issuer": "https://identity.wa.gov.au",
    "AllowInsecureHttp": false,
    "ClientId": "<FROM_KEY_VAULT>",
    "ClientSecret": "<FROM_KEY_VAULT>",
    "ApiBaseUrl": "https://api.servicewa.wa.gov.au",
    "Scope": "openid profile identity.verify"
  },
  "Jwt": {
    "Signer": "KeyVaultRsa",
    "SigningKeyVaultUri": "https://<KEY_VAULT_NAME>.vault.azure.net/",
    "SigningKeySecretName": "jwt-signing-key-pem",
    "Issuer": "NumbatWallet",
    "Audience": "NumbatWallet.Api",
    "ExpiryMinutes": 60,
    "_Comment": "Outside Development/Testing the app REQUIRES Signer=KeyVaultRsa (RS256 via Key Vault) and fails fast at startup otherwise. HS256 SecretKey is dev-only."
  },
  "ApiKey": {
    "Enabled": true,
    "Keys": {
      "_Comment": "API keys stored in Azure Key Vault - retrieved at runtime"
    }
  },
  "Tenants": {
    "default": {
      "Name": "Default Organization",
      "Identifier": "default",
      "IsActive": true,
      "ConnectionString": "Host=<POSTGRES_SERVER>;Database=numbatwallet_default;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require",
      "Settings": {
        "MaxUsers": "1000",
        "MaxCredentials": "10000"
      }
    },
    "wa-gov": {
      "Name": "Government of Western Australia",
      "Identifier": "wa-gov",
      "IsActive": true,
      "ConnectionString": "Host=<POSTGRES_SERVER>;Database=numbatwallet_wagov;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require",
      "Settings": {
        "MaxUsers": "50000",
        "MaxCredentials": "500000",
        "RequireStrongAuth": "true"
      }
    }
  },
  "GraphQL": {
    "EnablePlayground": false,
    "EnableIntrospection": false,
    "IncludeExceptionDetails": false,
    "MaxComplexity": 100,
    "MaxDepth": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<PRODUCTION_DOMAIN>",
      "https://admin.<PRODUCTION_DOMAIN>"
    ]
  },
  "Security": {
    "MutualTls": {
      "RequireClientCertificate": true,
      "ValidateCertificateChain": true,
      "AllowCertificateForwarding": false,
      "CertificateHeaderName": "X-Client-Cert",
      "AllowRenegotiation": false,
      "MinimumTrustLevel": "Medium",
      "ExcludedPaths": [
        "/health",
        "/.well-known"
      ]
    },
    "RequestSignature": {
      "RequireSignature": true,
      "MaxSignatureAgeSeconds": 300,
      "SignedHeaders": [
        "Content-Type",
        "Content-Length",
        "Host",
        "Date"
      ],
      "ExcludedPaths": [
        "/health",
        "/.well-known"
      ]
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowMinutes": 1
    },
    "Authenticated": {
      "PermitLimit": 200,
      "WindowMinutes": 1
    },
    "Strict": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "Relaxed": {
      "PermitLimit": 1000,
      "WindowMinutes": 1
    },
    "ApiKey": {
      "TokenLimit": 5000,
      "ReplenishmentSeconds": 60,
      "TokensPerPeriod": 500
    },
    "GraphQL": {
      "ConcurrentRequests": 20,
      "QueueLimit": 100
    },
    "Anonymous": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "NumbatWallet",
      "Environment": "Production"
    }
  },
  "EnableSensitiveDataLogging": false,
  "HealthChecks": {
    "UI": {
      "Enabled": true,
      "ApiPath": "/health/api",
      "UIPath": "/health/ui",
      "EvaluationTimeOnSeconds": 10,
      "MinimumSecondsBetweenFailureNotifications": 60
    }
  },
  "WalletBuilders": {
    "AppleWallet": {
      "TeamIdentifier": "<FROM_KEY_VAULT>",
      "PassTypeIdentifier": "pass.au.gov.wa.numbatwallet",
      "OrganizationName": "Government of Western Australia",
      "WwdrCertificatePath": "/certificates/AppleWWDRCAG4.cer",
      "SigningCertificatePath": "<FROM_KEY_VAULT>",
      "SigningCertificatePassword": "<FROM_KEY_VAULT>",
      "DefaultBackgroundColor": "#003087",
      "DefaultForegroundColor": "#FFFFFF",
      "DefaultLabelColor": "#CCCCCC",
      "_Comment_Certificates": "Certificates stored in Azure Key Vault or Blob Storage - paths resolved at runtime",
      "_Comment_TeamIdentifier": "Apple Developer Team ID (10-character alphanumeric)",
      "_Comment_PassTypeIdentifier": "Registered Pass Type ID from Apple Developer Portal",
      "_Comment_WwdrCertificate": "Apple Worldwide Developer Relations Certificate Authority G4"
    },
    "GoogleWallet": {
      "ServiceAccountEmail": "<FROM_KEY_VAULT>",
      "PrivateKey": "<FROM_KEY_VAULT>",
      "IssuerId": "<FROM_KEY_VAULT>",
      "DefaultBackgroundColor": "#003087",
      "ApiEndpoint": "https://walletobjects.googleapis.com/walletobjects/v1",
      "_Comment_ServiceAccount": "Google Cloud Service Account with Google Wallet API access",
      "_Comment_IssuerId": "Google Wallet Issuer ID (format: 3388000000022XXXXXX)",
      "_Comment_PrivateKey": "Service account private key (JSON key file content or path)",
      "_Comment_Setup": "Create service account at console.cloud.google.com/iam-admin/serviceaccounts"
    },
    "WebWallet": {
      "BaseUrl": "https://<PRODUCTION_DOMAIN>",
      "DefaultTheme": "light",
      "DefaultPrimaryColor": "#003087",
      "DefaultSecondaryColor": "#F0F0F0",
      "EnableQrCodeByDefault": true,
      "EnableSharingByDefault": true,
      "EnablePrintingByDefault": true,
      "EnableOfflineModeByDefault": true,
      "QrCodeErrorCorrection": "M",
      "QrCodeSize": 300,
      "_Comment_BaseUrl": "Production domain for wallet share URLs and QR codes",
      "_Comment_Colors": "WA Government brand colors (blue #003087)"
    }
  }
}
