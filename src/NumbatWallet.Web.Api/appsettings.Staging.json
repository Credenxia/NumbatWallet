{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "NumbatWallet": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<POSTGRES_SERVER_STAGING>;Database=numbatwallet_staging;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require",
    "Redis": "<REDIS_HOST_STAGING>:6380,password=<FROM_KEY_VAULT>,ssl=true,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Azure": {
    "KeyVault": {
      "Url": "https://<KEY_VAULT_NAME_STAGING>.vault.azure.net/"
    },
    "Storage": {
      "AccountName": "<STORAGE_ACCOUNT_NAME_STAGING>"
    },
    "ApplicationInsights": {
      "ConnectionString": "InstrumentationKey=<APP_INSIGHTS_KEY_STAGING>;IngestionEndpoint=https://australiaeast-1.in.applicationinsights.azure.com/"
    }
  },
  "UseAzureKeyVault": true,
  "UseBlobStorage": true,
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<AZURE_AD_TENANT_ID>",
    "ClientId": "<AZURE_AD_CLIENT_ID_STAGING>",
    "ClientSecret": "<FROM_KEY_VAULT>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc"
  },
  "ServiceWA": {
    "Authority": "https://identity-staging.wa.gov.au",
    "Audience": "numbatwallet-api-staging",
    "Issuer": "https://identity-staging.wa.gov.au",
    "AllowInsecureHttp": false,
    "ClientId": "<FROM_KEY_VAULT>",
    "ClientSecret": "<FROM_KEY_VAULT>",
    "ApiBaseUrl": "https://api-staging.servicewa.wa.gov.au",
    "Scope": "openid profile identity.verify"
  },
  "Jwt": {
    "Signer": "KeyVaultRsa",
    "SigningKeyVaultUri": "https://<KEY_VAULT_NAME>.vault.azure.net/",
    "SigningKeySecretName": "jwt-signing-key-pem",
    "Issuer": "NumbatWallet.Staging",
    "Audience": "NumbatWallet.Api.Staging",
    "ExpiryMinutes": 120,
    "_Comment": "Outside Development/Testing the app REQUIRES Signer=KeyVaultRsa (RS256 via Key Vault) and fails fast at startup otherwise. HS256 SecretKey is dev-only."
  },
  "ApiKey": {
    "Enabled": true,
    "Keys": {
      "_Comment": "API keys stored in Azure Key Vault - retrieved at runtime"
    }
  },
  "Tenants": {
    "default": {
      "Name": "Default Organization (Staging)",
      "Identifier": "default",
      "IsActive": true,
      "ConnectionString": "Host=<POSTGRES_SERVER_STAGING>;Database=numbatwallet_staging_default;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require",
      "Settings": {
        "MaxUsers": "1000",
        "MaxCredentials": "10000"
      }
    },
    "wa-gov": {
      "Name": "Government of Western Australia (Staging)",
      "Identifier": "wa-gov",
      "IsActive": true,
      "ConnectionString": "Host=<POSTGRES_SERVER_STAGING>;Database=numbatwallet_staging_wagov;Username=<POSTGRES_USER>;Password=<FROM_KEY_VAULT>;Port=5432;SSL Mode=Require",
      "Settings": {
        "MaxUsers": "50000",
        "MaxCredentials": "500000",
        "RequireStrongAuth": "true"
      }
    }
  },
  "GraphQL": {
    "EnablePlayground": true,
    "EnableIntrospection": true,
    "IncludeExceptionDetails": true,
    "MaxComplexity": 100,
    "MaxDepth": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<STAGING_DOMAIN>",
      "https://admin.<STAGING_DOMAIN>",
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Security": {
    "MutualTls": {
      "RequireClientCertificate": false,
      "ValidateCertificateChain": true,
      "AllowCertificateForwarding": false,
      "CertificateHeaderName": "X-Client-Cert",
      "AllowRenegotiation": false,
      "MinimumTrustLevel": "Low",
      "ExcludedPaths": [
        "/health",
        "/swagger",
        "/.well-known",
        "/api/v1/auth/token"
      ]
    },
    "RequestSignature": {
      "RequireSignature": false,
      "MaxSignatureAgeSeconds": 300,
      "SignedHeaders": [
        "Content-Type",
        "Content-Length",
        "Host"
      ],
      "ExcludedPaths": [
        "/health",
        "/swagger",
        "/.well-known"
      ]
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowMinutes": 1
    },
    "Authenticated": {
      "PermitLimit": 200,
      "WindowMinutes": 1
    },
    "Strict": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "Relaxed": {
      "PermitLimit": 1000,
      "WindowMinutes": 1
    },
    "ApiKey": {
      "TokenLimit": 2000,
      "ReplenishmentSeconds": 60,
      "TokensPerPeriod": 200
    },
    "GraphQL": {
      "ConcurrentRequests": 15,
      "QueueLimit": 75
    },
    "Anonymous": {
      "PermitLimit": 30,
      "WindowMinutes": 1
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "NumbatWallet",
      "Environment": "Staging"
    }
  },
  "EnableSensitiveDataLogging": true,
  "HealthChecks": {
    "UI": {
      "Enabled": true,
      "ApiPath": "/health/api",
      "UIPath": "/health/ui",
      "EvaluationTimeOnSeconds": 10,
      "MinimumSecondsBetweenFailureNotifications": 60
    }
  },
  "WalletBuilders": {
    "AppleWallet": {
      "TeamIdentifier": "<FROM_KEY_VAULT>",
      "PassTypeIdentifier": "pass.au.gov.wa.numbatwallet.staging",
      "OrganizationName": "Government of Western Australia (Staging)",
      "WwdrCertificatePath": "/certificates/AppleWWDRCAG4.cer",
      "SigningCertificatePath": "<FROM_KEY_VAULT>",
      "SigningCertificatePassword": "<FROM_KEY_VAULT>",
      "DefaultBackgroundColor": "#003087",
      "DefaultForegroundColor": "#FFFFFF",
      "DefaultLabelColor": "#CCCCCC",
      "_Comment_Certificates": "Test certificates for staging - can use same certs as production",
      "_Comment_TeamIdentifier": "Apple Developer Team ID (same as production)",
      "_Comment_PassTypeIdentifier": "Separate Pass Type ID for staging environment",
      "_Comment_Testing": "Use staging Pass Type ID to avoid conflicts with production passes"
    },
    "GoogleWallet": {
      "ServiceAccountEmail": "<FROM_KEY_VAULT>",
      "PrivateKey": "<FROM_KEY_VAULT>",
      "IssuerId": "<FROM_KEY_VAULT>",
      "DefaultBackgroundColor": "#003087",
      "ApiEndpoint": "https://walletobjects.googleapis.com/walletobjects/v1",
      "_Comment_ServiceAccount": "Separate Google Cloud project for staging recommended",
      "_Comment_IssuerId": "Staging Google Wallet Issuer ID",
      "_Comment_Testing": "Can use production service account for testing if no staging project"
    },
    "WebWallet": {
      "BaseUrl": "https://<STAGING_DOMAIN>",
      "DefaultTheme": "light",
      "DefaultPrimaryColor": "#003087",
      "DefaultSecondaryColor": "#F0F0F0",
      "EnableQrCodeByDefault": true,
      "EnableSharingByDefault": true,
      "EnablePrintingByDefault": true,
      "EnableOfflineModeByDefault": true,
      "QrCodeErrorCorrection": "M",
      "QrCodeSize": 300,
      "_Comment_BaseUrl": "Staging domain for wallet share URLs",
      "_Comment_Testing": "All features enabled for testing in staging"
    }
  }
}
